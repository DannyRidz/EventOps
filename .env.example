# Local development only. Production always rejects the internal UI route.
EVENTOPS_INTERNAL_UI=0
NEXT_TELEMETRY_DISABLED=1

# Set all three to enable real email sign in and private event persistence.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service role or secret key to browser configuration.
