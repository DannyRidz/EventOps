# Local development only. Production always rejects the internal UI route.
EVENTOPS_INTERNAL_UI=0
NEXT_TELEMETRY_DISABLED=1

# Set all three to enable real email sign in and private event persistence.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service role or secret key to browser configuration.

# Live analysis stays disabled until the operator has verified provider access,
# required terms, billing bounds, and privacy settings. These are attestations,
# not automatic acceptance. Also enable the private database gate deliberately.
EVENTOPS_MODEL_ENABLED=0
EVENTOPS_META_ACCESS_VERIFIED=0
EVENTOPS_META_BILLING_BOUND_VERIFIED=0
# MODEL_API_KEY and WORKER_DATABASE_URL belong only in the worker environment.

# Voice has its own disabled gate. It also requires the verified access/billing flags.
EVENTOPS_VOICE_ENABLED=0

# Separate retention worker environment only (never NEXT_PUBLIC credentials).
# WORKER_DATABASE_URL=
# EVENTOPS_RETENTION_STORAGE_TOKEN=
# EVENTOPS_DELETION_LEDGER=/independent/private-volume/tombstones.jsonl
# EVENTOPS_RETENTION_ONCE=1
