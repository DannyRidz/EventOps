# Copy to ignored .env.worker.local only when configuring the worker deliberately.
# Use a dedicated LOGIN with NOINHERIT granted only eventops_worker membership.
WORKER_DATABASE_URL=
MODEL_API_KEY=
EVENTOPS_MODEL_ENABLED=0
EVENTOPS_META_ACCESS_VERIFIED=0
EVENTOPS_META_BILLING_BOUND_VERIFIED=0

# Voice and cleanup worker. No provider execution while this stays 0.
EVENTOPS_VOICE_ENABLED=0
# Cleanup needs restricted DB and Storage access even when voice/model access is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A separately provisioned, short lived JWT with role eventops_worker, never an
# owner access token or a service role key. Keep it only in private worker config.
EVENTOPS_AUDIO_STORAGE_TOKEN=
# Absolute path to a reviewed ffmpeg executable inside a restricted worker container.
EVENTOPS_FFMPEG_PATH=
